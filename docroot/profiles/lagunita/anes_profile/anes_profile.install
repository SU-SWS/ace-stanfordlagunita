<?php

/**
 * @file
 * anes_profile.install
 */

/**
 * Implements hook_update_last_removed().
 */
function anes_profile_update_last_removed() {
  return 11000;
}

/**
 * Uninstall anes_profile_helper module.
 */
function anes_profile_update_11001() {
  \Drupal::service('module_installer')->uninstall(['anes_profile_helper']);
  return 'Uninstalled anes_profile_helper module.';
}

