<?php

/**
 * @file
 * Primary module hooks for Anesthesiology Helper module.
 */

/**
 * Implements hook_paragraphs_behavior_info_alter().
 */
function anes_helper_paragraphs_behavior_info_alter(&$paragraphs_behavior) {
  $paragraphs_behavior['su_card_styles']['class'] = '\Drupal\anes_helper\Plugin\paragraphs\Behavior\AnesCardBehaviors';
}
