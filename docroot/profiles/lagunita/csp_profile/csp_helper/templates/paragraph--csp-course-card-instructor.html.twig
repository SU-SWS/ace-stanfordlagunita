{#
/**
 * @file
 * Rough Drupal-side preview of a Course Card Instructor sub-paragraph.
 * See paragraph--csp-faux-course-card.html.twig for context.
 *
 * Variables:
 * - instructor_name: plain text Name value.
 * - instructor_title: plain text Title value.
 * - instructor_url: resolved URL for the instructor's profile, if any.
 */
#}
{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished',
    'csp-course-card-preview__instructor',
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {% if content.csp_instructor_headshot %}
    {{ content.csp_instructor_headshot }}
  {% endif %}
  <div class="csp-course-card-preview__instructor-text">
    <div class="csp-course-card-preview__instructor-name">
      {% if instructor_url %}
        <a href="{{ instructor_url }}">{{ instructor_name }}</a>
      {% else %}
        {{ instructor_name }}
      {% endif %}
    </div>
    {% if instructor_title %}
      <div class="csp-course-card-preview__instructor-title">{{ instructor_title }}</div>
    {% endif %}
  </div>
</div>
