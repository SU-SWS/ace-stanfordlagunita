{#
/**
 * @file
 * Maps the Course Card Instructor paragraph onto the matching component.
 *
 */
#}
{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished',
  ]
%}
{{ include('csp_helper:course_card_instructor', {
  attributes: attributes.addClass(classes),
  name: paragraph.csp_instructor_name.value ?? '',
  title: paragraph.csp_instructor_title.value ?? '',
  url: paragraph.csp_instructor_url.isEmpty ? '' : paragraph.csp_instructor_url.0.getUrl.toString,
  headshot: content.csp_instructor_headshot,
}, with_context = false) }}
