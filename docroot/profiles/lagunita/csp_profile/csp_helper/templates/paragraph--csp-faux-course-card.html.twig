{#
/**
 * @file

 *
 * Variables:
 * - course_card_color_hex: approximate hex for the selected color bar.
 * - course_card_format: plain text Format value.
 * - course_card_location: plain text Location value.
 * - course_card_url: resolved URL for the card link.
 */
#}
{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished',
    'csp-course-card-preview',
  ]
%}

<div{{ attributes.addClass(classes) }}>
  {% if content.csp_course_card_image %}
    <div class="csp-course-card-preview__image">
      {% if course_card_url %}
        <a href="{{ course_card_url }}">{{ content.csp_course_card_image }}</a>
      {% else %}
        {{ content.csp_course_card_image }}
      {% endif %}
    </div>
  {% endif %}
  <div class="csp-course-card-preview__body">
    <div class="csp-course-card-preview__color-bar" style="background-color: {{ course_card_color_hex }}"></div>

    {% if course_card_format or course_card_location %}
      <div class="csp-course-card-preview__meta">
        {{ course_card_format }}
        {% if course_card_format and course_card_location %}
          <span class="divider">|</span>
        {% endif %}
        {{ course_card_location }}
      </div>
    {% endif %}

    <h3 class="csp-course-card-preview__title">
      {% if course_card_url %}
        <a href="{{ course_card_url }}">{{ content.csp_course_card_title }}</a>
      {% else %}
        {{ content.csp_course_card_title }}
      {% endif %}
    </h3>

    {% if content.csp_course_card_instructors %}
      <div class="csp-course-card-preview__instructors">
        {{ content.csp_course_card_instructors }}
      </div>
    {% endif %}
  </div>
</div>
