{#
/**
 * @file
 * Maps the Faux Course Card paragraph onto the course_card_preview component.
 *
 * Variables:
 * - course_card_color_hex: hex for the selected color bar.
 * - course_card_title: plain text Title value.
 * - course_card_format: plain text Format value.
 * - course_card_location: plain text Location value.
 * - course_card_url: resolved URL for the card link.
 */
#}
{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished',
  ]
%}
{{ include('csp_helper:course_card_preview', {
  attributes: attributes.addClass(classes),
  title: course_card_title,
  color_hex: course_card_color_hex,
  format: course_card_format,
  location: course_card_location,
  url: course_card_url,
  image: content.csp_course_card_image,
  instructors: content.csp_course_card_instructors,
}, with_context = false) }}
