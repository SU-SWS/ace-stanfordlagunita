{
    "name": "su-sws/summer_profile",
    "description": "Installation Profile for the Stanford Webservice's Jumpstart Product.",
    "type": "drupal-custom-profile",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "drupal/double_field": "^5.0",
        "drupal/splide": "^2.0",
        "drupal/views_data_export": "^1.5",
        "league/commonmark": "^1.0",
        "php-ffmpeg/php-ffmpeg": "^1.3",
        "su-sws/markdown": "^3.0",
        "webtourismus/splidejs": "^4.1"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Drupal\\summer_profile\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\Tests\\summer_profile\\": "tests/src"
        }
    },
    "extra": {
        "drush": {
            "services": {
                "drush.services.yml": "^9"
            }
        },
        "patches": {
            "drupal/markdown": {
                "https://www.drupal.org/project/markdown/issues/3409277": "https://git.drupalcode.org/project/markdown/-/merge_requests/29.patch",
                "https://www.drupal.org/project/markdown/issues/3483437": "https://git.drupalcode.org/project/markdown/-/merge_requests/35.diff"
            },
            "su-sws/markdown": {
                "https://www.drupal.org/project/markdown/issues/3529633": "https://git.drupalcode.org/project/markdown/-/merge_requests/51.diff"
            }
        }
    }
}
