<?php

/**
 * @file
 * supress_helper.module
 */

/**
 * Implements hook_cron().
 */
function supress_helper_cron() {
  /** @var \Drupal\supress_helper\PressFilemakerInterface $filemaker */
  $filemaker = \Drupal::service('supress_helper.filemaker');
  $social_links = $filemaker->getSocialLinks() ?: [];
  $social_links = ['response' => ['data' => $social_links]];
  file_put_contents('public://social-links.json', json_encode($social_links, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
  $filemaker->queueCoverImages();
}

